# Face Attendance System Configuration

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27018
MONGODB_USERNAME=admin
MONGODB_PASSWORD=password123
MONGODB_DATABASE=face_attendance
MONGODB_CONNECTION_STRING=mongodb://admin:password123@localhost:27018

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=face_vectors

# Face Recognition Configuration
FACE_SIMILARITY_THRESHOLD=0.8
MAX_IMAGES_PER_USER=5

# Image Processing Configuration
IMAGE_RESIZE_WIDTH=600
THUMBNAIL_SIZE=150
MAX_IMAGE_SIZE_MB=10
MIN_IMAGE_SIZE_KB=1

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*

# Model Configuration
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
FACENET_MODEL=vggface2

# Database Connection Settings
DB_MAX_RETRIES=3
DB_RETRY_DELAY=2
DB_CONNECTION_TIMEOUT=5000

# Logging Configuration
LOG_LEVEL=INFO